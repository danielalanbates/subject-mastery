From 01f1906dbc6eff9274a9845ca73338bd92de8ef9 Mon Sep 17 00:00:00 2001
From: Daniel Bates <help@batesai.org>
Date: Fri, 2 Oct 2026 10:47:48 -0700
Subject: [PATCH 1/8] Match production: /qola 301s to qolabible.com, Qola
 headers block removed

Production (deployment a62e742f, 2026-09-26) was uploaded from a staging
copy in which /qola had been removed at Daniel's request: _redirects gained
two 301s to https://qolabible.com/ and the Qola block was cut from _headers.
Neither change was ever committed, so a fresh build of 7eea212f would have
brought the Qola headers back and dropped the redirect. This puts both into
source so a build of this branch reproduces the live static site.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 public/_headers   | 21 ---------------------
 public/_redirects |  3 +++
 2 files changed, 3 insertions(+), 21 deletions(-)

diff --git a/public/_headers b/public/_headers
index 61242a26..a03f78dc 100644
--- a/public/_headers
+++ b/public/_headers
@@ -21,24 +21,3 @@
 
 /play/index.html
   Cache-Control: no-cache
-
-# --- Qola (managed by qola tools/deploy.sh) ---
-/qola/*
-  X-Content-Type-Options: nosniff
-  Referrer-Policy: no-referrer
-  Permissions-Policy: geolocation=(), camera=(), microphone=()
-
-# Scripture is immutable: a text never changes once published.
-/qola/data/text/*
-  Cache-Control: public, max-age=31536000, immutable
-
-# The catalogue and the app shell must be able to change.
-/qola/data/catalog.json
-  Cache-Control: no-cache
-/qola/index.html
-  Cache-Control: no-cache
-/qola/app.js
-  Cache-Control: no-cache
-/qola/sw.js
-  Cache-Control: no-cache
-
diff --git a/public/_redirects b/public/_redirects
index 446e3ea7..c0a52aca 100644
--- a/public/_redirects
+++ b/public/_redirects
@@ -1,3 +1,6 @@
 # /membership was parked at /products while the tab was archived. It is a real
 # page again (Sign in with Apple), so the redirect has to go — left in place it
 # would swallow the sign-in return trip.
+
+/qola https://qolabible.com/ 301
+/qola/* https://qolabible.com/ 301
-- 
2.51.2

