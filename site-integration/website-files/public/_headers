/sitemap.xml
  Content-Type: application/xml

/robots.txt
  Content-Type: text/plain

# Antediluvia browser build. Without long caching every visit re-downloads
# ~100 MB. The engine is safe to pin forever because the loader requests it
# with a ?v=<build hash> that changes on every rebuild. Game assets are
# requested by plain path with no such stamp, so they only get a day — long
# enough to help repeat visits, short enough that new art appears on its own.
/play/pkg/*
  Cache-Control: public, max-age=31536000, immutable

/play/assets/*
  Cache-Control: public, max-age=86400

# The loader carries the build stamp, so it must never be cached itself.
/play/
  Cache-Control: no-cache

/play/index.html
  Cache-Control: no-cache
